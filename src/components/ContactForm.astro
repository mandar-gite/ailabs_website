---
// This form uses Formspree as the backend for static forms.
// You must replace the action URL with your unique Formspree endpoint.
const FORM_ENDPOINT = "https://formspree.io/f/xdkdvzvl";
import LogoMark from "./LogoMark.astro";
---
<section id="contact" class="pt-4 pb-6">
  <h2 class="text-3xl font-bold text-white mb-10 text-center sr-only">Book a Call or Send an Inquiry</h2>
  <div class="bg-white p-4 rounded-lg shadow-xl max-w-md mx-auto text-[#0C1A3F]">
    <div class="flex justify-center mb-3">
      <LogoMark size={56} />
    </div>
    <form id="contact-form" action={FORM_ENDPOINT} method="POST" class="space-y-3.5">
      <!-- Metadata for better inbox + redirect after submit -->
      <input type="hidden" name="_subject" value="New inquiry from 72° AI Labs" />
      <input type="hidden" name="_redirect" value="https://72ai.in/thanks" />

      <!-- Two-column grid for Name, Company, Email, Phone -->
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label for="name" class="block text-sm text-[#0C1A3F] mb-1.5">Name</label>
          <input type="text" id="name" name="Name" class="w-full px-3 py-2 text-sm rounded-md bg-white text-[#0C1A3F] border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#DDA744]" required>
        </div>
        <div>
          <label for="company" class="block text-sm text-[#0C1A3F] mb-1.5">Company</label>
          <input type="text" id="company" name="Company" class="w-full px-3 py-2 text-sm rounded-md bg-white text-[#0C1A3F] border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#DDA744]" required>
        </div>
        <div>
          <label for="email" class="block text-sm text-[#0C1A3F] mb-1.5">Email</label>
          <input type="email" id="email" name="Email" class="w-full px-3 py-2 text-sm rounded-md bg-white text-[#0C1A3F] border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#DDA744]" required>
        </div>
        <div>
          <label for="phone" class="block text-sm text-[#0C1A3F] mb-1.5">Phone</label>
          <input type="tel" id="phone" name="Phone" class="w-full px-3 py-2 text-sm rounded-md bg-white text-[#0C1A3F] border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#DDA744]" required>
        </div>
      </div>

      <!-- Full-width Your Brief -->
      <div>
        <label for="message" class="block text-sm text-[#0C1A3F] mb-1.5">Your Brief</label>
        <textarea id="message" name="Brief" rows="4" class="w-full px-3 py-2 text-sm rounded-md bg-white text-[#0C1A3F] border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[#DDA744] min-h-[100px]" required></textarea>
      </div>
      <div class="flex items-start">
        <input type="checkbox" id="consent" name="Consent" class="mt-0.5" required>
        <label for="consent" class="ml-2 text-gray-600 text-xs leading-tight">
          I consent to 72° AI LABS collecting my data for the purpose of this inquiry.
        </label>
      </div>
      <!-- Honeypot field for bot protection -->
      <input type="text" name="_gotcha" style="display:none !important">
      <div class="text-center pt-1">
        <button type="submit" class="px-6 py-2 text-sm bg-[#DDA744] hover:bg-[#c49038] text-[#0C1A3F] font-semibold rounded-full shadow-lg transition-colors duration-300">
          Send Message
        </button>
      </div>
    </form>
  </div>
</section>

<script>
  // Progressive enhancement: with JS, submit to BOTH the HubSpot Worker (owns the
  // lead in the CRM) and Formspree (email notification + fallback so no lead is lost),
  // then redirect to /thanks. Without JS, the plain <form action> still posts to
  // Formspree with its _redirect, so leads are captured either way.
  const HUBSPOT_ENDPOINT = "https://72ai.in/api/lead";
  const form = document.getElementById("contact-form") as HTMLFormElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const payload: Record<string, string> = {};
    fd.forEach((v, k) => (payload[k] = String(v)));

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (btn) { btn.disabled = true; btn.textContent = "Sending…"; }

    await Promise.allSettled([
      fetch(HUBSPOT_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      }),
      fetch(form.action, {
        method: "POST",
        headers: { Accept: "application/json" },
        body: fd,
      }),
    ]);

    window.location.href = "/thanks";
  });
</script>
