---
// HubSpot Meetings scheduler. Bookings land in HubSpot as meetings on the
// contact record, alongside leads from the Worker at 72ai.in/api/lead.
const MEETINGS_URL = "https://meetings-na2.hubspot.com/mandar-gite";
---
<div id="book-call" class="book-call">
  <h3>Book a 30-min call</h3>
  <div class="book-card">
    <ul class="book-points">
      <li>30 minutes with Mandar, the founder</li>
      <li>Talk through your problem before writing a brief</li>
      <li>Times shown in your own time zone</li>
    </ul>
    <button type="button" id="show-times" class="book-show">Show available times</button>
    <div class="meetings-iframe-container" data-src={`${MEETINGS_URL}?embed=true`} hidden>
      <p class="meetings-placeholder">Loading available slots...</p>
    </div>
    <p class="book-call-fallback">
      Or <a href={MEETINGS_URL} target="_blank" rel="noopener noreferrer">open the booking page</a> in a new tab
    </p>
  </div>
</div>

<script>
  // HubSpot's embed sets its own cookie and looks unlike the site, so it loads
  // only when the visitor asks for times. MeetingsEmbedCode.js scans for
  // .meetings-iframe-container when it runs and builds the iframe straight away.
  const EMBED_SCRIPT = "https://static.hsappstatic.net/MeetingsEmbed/ex/MeetingsEmbedCode.js";
  const btn = document.getElementById("show-times");
  const container = document.querySelector<HTMLElement>("#book-call .meetings-iframe-container");

  btn?.addEventListener("click", () => {
    if (!container) return;
    container.hidden = false;
    btn.hidden = true;
    if (document.querySelector(`script[src="${EMBED_SCRIPT}"]`)) return;
    const s = document.createElement("script");
    s.src = EMBED_SCRIPT;
    s.async = true;
    document.body.appendChild(s);
  });
</script>

<style>
  .book-call h3 {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--wp-ink);
    margin: 0 0 1rem;
    text-align: center;
  }

  /* Matches the contact form card beside it */
  .book-card {
    background: #fff;
    border-radius: 0.5rem;
    padding: 1.5rem;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    max-width: 28rem;
    margin: 0 auto;
  }

  .book-points {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .book-points li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--wp-ink-2);
  }

  .book-points li::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--wp-gold);
    flex-shrink: 0;
    transform: translateY(-1px);
  }

  .book-show {
    display: block;
    width: 100%;
    padding: 0.8rem 1rem;
    border: 0;
    border-radius: 999px;
    background: var(--wp-ink);
    color: #fff;
    font-weight: 700;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .book-show:hover {
    background: var(--wp-ink-2);
  }

  .book-show[hidden],
  .meetings-iframe-container[hidden] {
    display: none;
  }

  .meetings-iframe-container {
    min-height: 420px;
    border-radius: 0.5rem;
    overflow: hidden;
  }

  /* Shown until HubSpot's script inserts its iframe */
  .meetings-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 420px;
    margin: 0;
    border: 1px dashed var(--wp-line-2);
    border-radius: 0.5rem;
    font-size: 0.9rem;
    color: var(--wp-ink-2);
  }

  .meetings-iframe-container:has(iframe) .meetings-placeholder {
    display: none;
  }

  .book-call-fallback {
    font-size: 0.8rem;
    color: var(--wp-ink-2);
    margin: 0.75rem 0 0;
    text-align: center;
  }

  .book-call-fallback a {
    color: var(--wp-ink);
    font-weight: 600;
    text-decoration: underline;
  }
</style>
