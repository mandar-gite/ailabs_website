---
// Renders the visible trail and its BreadcrumbList JSON-LD from 1 list,
// so the two can't drift apart (Google requires the markup to match visible content).
interface Props {
  items: { name: string; href: string }[];
}
const { items } = Astro.props;
const ld = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((it, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": it.name,
    "item": new URL(it.href, Astro.site).href,
  })),
};
---

<nav aria-label="Breadcrumb" class="breadcrumb">
  <ol>
    {items.map((it, i) =>
      i === items.length - 1
        ? <li><span aria-current="page">{it.name}</span></li>
        : <li><a href={it.href}>{it.name}</a></li>
    )}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />

<style>
  .breadcrumb { font-size: 0.875rem; color: var(--wp-ink-2); margin-bottom: 2rem; }
  ol { list-style: none; margin: 0; padding: 0; display: flex; }
  li { white-space: nowrap; }
  li + li::before { content: "/"; margin: 0 0.5rem; }
  /* long post titles repeat the H1 below, so 1 line with an ellipsis is enough */
  li:last-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  a { color: var(--brand-blue); text-decoration: underline; text-underline-offset: 2px; transition: color 0.2s ease; }
  a:hover { color: var(--brand-gold); }
</style>
