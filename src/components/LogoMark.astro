---
// Single source of truth for the 72° brand mark (navy pentagon + gold spiral).
// Mark-only asset derived from the full logo lockup; consumers render any text
// separately (Nav/Footer/ContactForm/about). Size in px via the `size` prop.
interface Props {
    size?: number;
}
const { size = 40 } = Astro.props;
---
<img
    src="/logos/logo-mark.png"
    width={size}
    height={size}
    alt=""
    aria-hidden="true"
    class="logo-mark"
    decoding="async"
/>
<style>
    .logo-mark {
        display: block;
        flex-shrink: 0;
        max-width: none; /* override Tailwind base img { max-width: 100% } */
        object-fit: contain;
    }
</style>
