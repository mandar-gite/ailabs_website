---
// Cookie consent. Layout renders this only when a tracker ID is configured.
// Trackers push their start-up code onto window.__consentQueue; it runs only
// after Accept. The choice is kept in localStorage under 72ai_consent.
---
<div id="consent-banner" class="consent-banner" role="dialog" aria-labelledby="consent-title" hidden>
  <p id="consent-title" class="consent-title">Cookies on 72ai.in</p>
  <p class="consent-text">
    With your OK, we use Google Analytics and Microsoft Clarity to see how the site is used, and Apollo to see which companies visit. Nothing loads unless you accept. <a href="/privacy">Privacy policy</a>
  </p>
  <div class="consent-actions">
    <button type="button" data-consent="denied">Decline</button>
    <button type="button" data-consent="granted">Accept</button>
  </div>
</div>

<script>
  const KEY = "72ai_consent";
  const read = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
  const save = (v: string) => { try { localStorage.setItem(KEY, v); } catch { /* private mode: ask again next visit */ } };

  const banner = document.getElementById("consent-banner");
  let started = false;
  const startTrackers = () => {
    if (started) return;
    started = true;
    const queue = (window as any).__consentQueue || [];
    for (const fn of queue) { try { fn(); } catch { /* one tracker failing mustn't stop the rest */ } }
  };

  if (banner) {
    const choice = read();
    if (choice === "granted") startTrackers();
    else if (choice !== "denied") banner.hidden = false;

    banner.querySelectorAll<HTMLButtonElement>("[data-consent]").forEach((btn) =>
      btn.addEventListener("click", () => {
        const value = btn.dataset.consent!;
        save(value);
        banner.hidden = true;
        if (value === "granted") startTrackers();
      }),
    );

    // Footer "Cookie settings" stays hidden on pages without the banner.
    document.querySelectorAll<HTMLButtonElement>("[data-consent-open]").forEach((el) => {
      el.hidden = false;
      el.addEventListener("click", () => { banner.hidden = false; });
    });
  }
</script>

<style>
  .consent-banner {
    position: fixed;
    left: 1.25rem;
    bottom: 1.25rem;
    z-index: 50;
    max-width: 400px;
    padding: 1.1rem 1.25rem;
    background: #fff;
    border: 1px solid var(--wp-line-2);
    border-radius: 14px;
    box-shadow: 0 12px 32px rgba(26, 34, 56, 0.18);
  }

  .consent-banner[hidden] {
    display: none;
  }

  .consent-title {
    margin: 0 0 0.35rem;
    font-weight: 700;
    color: var(--wp-ink);
  }

  .consent-text {
    margin: 0 0 0.9rem;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--wp-ink-2);
  }

  .consent-text a {
    color: var(--wp-ink);
    font-weight: 600;
    text-decoration: underline;
  }

  .consent-actions {
    display: flex;
    gap: 0.6rem;
  }

  .consent-actions button {
    flex: 1;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.875rem;
    cursor: pointer;
    border: 1.5px solid var(--wp-ink);
    background: #fff;
    color: var(--wp-ink);
  }

  .consent-actions button[data-consent="granted"] {
    background: var(--wp-ink);
    color: #fff;
  }

  @media (max-width: 480px) {
    .consent-banner {
      left: 0.75rem;
      right: 0.75rem;
      bottom: 0.75rem;
      max-width: none;
    }
  }
</style>
