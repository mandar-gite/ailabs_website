---
// Page title block for index-style pages that would otherwise start without an h1.
interface Props { title: string; intro?: string; eyebrow?: string }
const { title, intro, eyebrow } = Astro.props;
---
<header class="page-header">
  {eyebrow && <p class="page-header-eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {intro && <p>{intro}</p>}
</header>

<style>
  .page-header {
    margin: 0 0 2rem;
    max-width: 720px;
  }

  .page-header .page-header-eyebrow {
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--wp-ink-2);
    margin: 0 0 0.5rem;
  }

  .page-header h1 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--wp-ink);
    margin: 0 0 0.75rem;
  }

  .page-header p {
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--wp-ink-2);
    margin: 0;
  }
</style>
