---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
---
<Layout title="Application received | 72° AI LABS" description="Thanks for your application to 72° AI LABS." noindex exitPopup={false}>
  <Nav />
  <main id="main-content" class="min-h-[60vh] flex items-center justify-center px-6 lg:px-8">
    <div class="text-center max-w-xl">
      <h1 class="text-4xl font-semibold mb-4">Thanks for applying</h1>
      <p class="opacity-80 mb-8">We've got your details. There are no open roles right now, so we keep good profiles on file and get in touch when there's a fit.</p>
      <a href="/" class="inline-block px-6 py-3 bg-[#1A2238] hover:bg-[#5B6472] text-white font-semibold rounded-full">Back to Home</a>
    </div>
  </main>
  <Footer />
</Layout>
