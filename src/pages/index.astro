---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import logoSvg from "../../logo_ver2.1.svg?url";
import logoJpg from "../../logo.jpg?url";

const seoTitle = "72° AI Labs - Practical AI for Real Business Systems";
const seoDescription = "Local models, RAG pipelines, OCR engines, forecasting stacks, and agentic workflows that run on everyday data. Each project solves an operational bottleneck without hype or abstraction.";
---

<Layout title={seoTitle} description={seoDescription}>
    <!-- Header with enhanced spacing -->
    <header class="modern-header">
        <div class="max-w-[1400px] mx-auto px-6 lg:px-8">
            <nav class="nav-modern">
                <a href="/" class="logo-container">
                    <picture>
                        <source media="(max-width: 640px)" srcset={logoJpg} type="image/jpeg" />
                        <source srcset={logoSvg} type="image/svg+xml" />
                        <img src={logoSvg} alt="72° AI Labs logo" class="logo-img" loading="eager" decoding="async" />
                    </picture>
                    <span class="company-name">72° AI LABS</span>
                </a>
                <div class="nav-links-modern">
                    <a href="/projects" class="nav-link">Projects</a>
                    <a href="/solutions" class="nav-link">Solutions</a>
                    <a href="/about" class="nav-link">About</a>
                    <a href="#contact" class="nav-link-cta">Contact</a>
                </div>
            </nav>

            <!-- Hero Section with Conceptual Graphic -->
            <div class="hero-modern">
                <div class="hero-content">
                    <h1 class="hero-title">
                        Practical AI Built for<br/>
                        <span class="hero-accent">Real Business Systems</span>
                    </h1>
                    <p class="hero-subtitle">
                        Local models, RAG pipelines, OCR engines, forecasting stacks, and agentic workflows
                        that run on everyday data. Each project solves an operational bottleneck without hype or abstraction.
                    </p>
                    <div class="hero-cta-group">
                        <a href="/projects" class="cta-primary">
                            <span>View Projects</span>
                            <svg class="cta-arrow" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                                <path d="M4 10h12M12 6l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                        </a>
                        <a href="#contact" class="cta-secondary">Get in Touch</a>
                    </div>
                </div>

                <!-- Conceptual Data Transformation Graphic -->
                <div class="hero-graphic">
                    <svg viewBox="0 0 600 400" fill="none" xmlns="http://www.w3.org/2000/svg" class="data-flow-svg" role="img" aria-label="Data transformation visualization showing messy data being processed into clear decisions">
                        <!-- Background subtle grid -->
                        <defs>
                            <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
                                <circle cx="2" cy="2" r="1" fill="rgba(0, 217, 255, 0.1)"/>
                            </pattern>
                            <linearGradient id="flowGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                                <stop offset="0%" style="stop-color:#0C1A3F;stop-opacity:0.3" />
                                <stop offset="100%" style="stop-color:#00D9FF;stop-opacity:0.8" />
                            </linearGradient>
                        </defs>
                        <rect width="600" height="400" fill="url(#grid)" opacity="0.3"/>

                        <!-- Left side: Messy data (chaotic nodes) -->
                        <g class="data-chaos">
                            <circle cx="80" cy="120" r="6" fill="#0C1A3F" opacity="0.6"/>
                            <circle cx="120" cy="90" r="4" fill="#0C1A3F" opacity="0.5"/>
                            <circle cx="90" cy="180" r="5" fill="#0C1A3F" opacity="0.6"/>
                            <circle cx="140" cy="160" r="6" fill="#0C1A3F" opacity="0.5"/>
                            <circle cx="70" cy="250" r="4" fill="#0C1A3F" opacity="0.6"/>
                            <circle cx="130" cy="220" r="5" fill="#0C1A3F" opacity="0.5"/>
                            <circle cx="110" cy="290" r="4" fill="#0C1A3F" opacity="0.6"/>

                            <!-- Chaotic connecting lines -->
                            <path d="M 80 120 Q 100 105 120 90" stroke="#0C1A3F" stroke-width="1" opacity="0.3"/>
                            <path d="M 90 180 Q 115 170 140 160" stroke="#0C1A3F" stroke-width="1" opacity="0.3"/>
                            <path d="M 70 250 Q 100 235 130 220" stroke="#0C1A3F" stroke-width="1" opacity="0.3"/>
                        </g>

                        <!-- Center: Transformation flow -->
                        <g class="transform-flow">
                            <!-- Flowing lines from left to right -->
                            <path d="M 150 120 Q 300 120 450 100" stroke="url(#flowGradient)" stroke-width="3" opacity="0.6" class="flow-line flow-1"/>
                            <path d="M 150 200 Q 300 200 450 200" stroke="url(#flowGradient)" stroke-width="3" opacity="0.6" class="flow-line flow-2"/>
                            <path d="M 150 280 Q 300 280 450 300" stroke="url(#flowGradient)" stroke-width="3" opacity="0.6" class="flow-line flow-3"/>

                            <!-- Processing nodes -->
                            <circle cx="300" cy="120" r="8" fill="#00D9FF" opacity="0.8" class="pulse-node"/>
                            <circle cx="300" cy="200" r="8" fill="#00D9FF" opacity="0.8" class="pulse-node"/>
                            <circle cx="300" cy="280" r="8" fill="#00D9FF" opacity="0.8" class="pulse-node"/>
                        </g>

                        <!-- Right side: Clear decisions (organized structure) -->
                        <g class="data-clarity">
                            <circle cx="480" cy="100" r="8" fill="#00D9FF" class="glow-node"/>
                            <circle cx="520" cy="100" r="8" fill="#00D9FF" class="glow-node"/>
                            <circle cx="480" cy="200" r="8" fill="#00D9FF" class="glow-node"/>
                            <circle cx="520" cy="200" r="8" fill="#00D9FF" class="glow-node"/>
                            <circle cx="480" cy="300" r="8" fill="#00D9FF" class="glow-node"/>
                            <circle cx="520" cy="300" r="8" fill="#00D9FF" class="glow-node"/>

                            <!-- Clear connecting lines -->
                            <line x1="480" y1="100" x2="520" y2="100" stroke="#00D9FF" stroke-width="2" opacity="0.8"/>
                            <line x1="480" y1="200" x2="520" y2="200" stroke="#00D9FF" stroke-width="2" opacity="0.8"/>
                            <line x1="480" y1="300" x2="520" y2="300" stroke="#00D9FF" stroke-width="2" opacity="0.8"/>
                        </g>

                        <!-- Labels -->
                        <text x="100" y="350" font-size="14" fill="#0C1A3F" opacity="0.6" font-weight="600">Messy Data</text>
                        <text x="470" y="350" font-size="14" fill="#00D9FF" font-weight="600">Clear Decisions</text>
                    </svg>
                </div>
            </div>
        </div>
    </header>

    <!-- Key Benefits Section with Custom Icons -->
    <section class="benefits-section">
        <div class="max-w-[1200px] mx-auto px-6 lg:px-8 py-20 lg:py-24">
            <div class="section-header">
                <h2 class="section-title-modern">AI That Solves Real Problems</h2>
                <p class="section-subtitle-modern">Speed, accuracy, cost, and decision-flow—fixed.</p>
            </div>

            <div class="benefits-grid">
                <!-- Benefit 1: Speed -->
                <div class="benefit-card">
                    <div class="benefit-icon">
                        <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                            <circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="2" opacity="0.2"/>
                            <path d="M24 14v10l7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                            <circle cx="24" cy="24" r="2" fill="currentColor"/>
                        </svg>
                    </div>
                    <h3 class="benefit-title">72hrs</h3>
                    <p class="benefit-desc">From Data to Insights</p>
                </div>

                <!-- Benefit 2: Integration -->
                <div class="benefit-card">
                    <div class="benefit-icon">
                        <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                            <rect x="8" y="18" width="12" height="12" stroke="currentColor" stroke-width="2" rx="2"/>
                            <rect x="28" y="18" width="12" height="12" stroke="currentColor" stroke-width="2" rx="2"/>
                            <path d="M20 24h8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                            <circle cx="24" cy="24" r="3" fill="currentColor"/>
                        </svg>
                    </div>
                    <h3 class="benefit-title">100%</h3>
                    <p class="benefit-desc">Works with Your Tools</p>
                </div>

                <!-- Benefit 3: Complexity -->
                <div class="benefit-card">
                    <div class="benefit-icon">
                        <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                            <path d="M24 8v32M8 24h32" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                            <circle cx="24" cy="24" r="16" stroke="currentColor" stroke-width="2" stroke-dasharray="4 4" opacity="0.3"/>
                            <path d="M24 16l-4 8h8l-4 8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                    <h3 class="benefit-title">Zero</h3>
                    <p class="benefit-desc">Complex Migrations</p>
                </div>

                <!-- Benefit 4: Accuracy -->
                <div class="benefit-card">
                    <div class="benefit-icon">
                        <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                            <circle cx="24" cy="24" r="18" stroke="currentColor" stroke-width="2" opacity="0.2"/>
                            <circle cx="24" cy="24" r="12" stroke="currentColor" stroke-width="2" opacity="0.4"/>
                            <circle cx="24" cy="24" r="6" stroke="currentColor" stroke-width="2"/>
                            <circle cx="24" cy="24" r="3" fill="currentColor"/>
                        </svg>
                    </div>
                    <h3 class="benefit-title">Precision</h3>
                    <p class="benefit-desc">Not Just Calculation</p>
                </div>
            </div>
        </div>
    </section>

    <!-- How It Works - Visual Timeline -->
    <section class="process-section">
        <div class="max-w-[1200px] mx-auto px-6 lg:px-8 py-20 lg:py-24">
            <div class="section-header">
                <h2 class="section-title-modern">How It Works</h2>
                <p class="section-subtitle-modern">From connection to commercial advantage</p>
            </div>

            <div class="process-timeline">
                <!-- Step 1 -->
                <div class="timeline-step">
                    <div class="step-marker">
                        <div class="step-number">01</div>
                        <div class="step-connector"></div>
                    </div>
                    <div class="step-content-box">
                        <h3 class="step-title">Connect Your Data</h3>
                        <p class="step-description">
                            Link your existing systems—Tally, Zoho, spreadsheets. No migration headaches.
                        </p>
                    </div>
                </div>

                <!-- Step 2 -->
                <div class="timeline-step">
                    <div class="step-marker">
                        <div class="step-number">02</div>
                        <div class="step-connector"></div>
                    </div>
                    <div class="step-content-box">
                        <h3 class="step-title">Smart Analysis</h3>
                        <p class="step-description">
                            AI finds patterns, predicts trends, and spots risks automatically.
                        </p>
                    </div>
                </div>

                <!-- Step 3 -->
                <div class="timeline-step">
                    <div class="step-marker">
                        <div class="step-number">03</div>
                        <div class="step-connector"></div>
                    </div>
                    <div class="step-content-box">
                        <h3 class="step-title">Clear Insights</h3>
                        <p class="step-description">
                            Plain English answers to your business questions. No technical jargon.
                        </p>
                    </div>
                </div>

                <!-- Step 4 -->
                <div class="timeline-step">
                    <div class="step-marker">
                        <div class="step-number">04</div>
                    </div>
                    <div class="step-content-box">
                        <h3 class="step-title">Take Action</h3>
                        <p class="step-description">
                            Specific recommendations you can implement immediately.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section with Data Background -->
    <section class="final-cta-section" id="contact">
        <div class="cta-background-pattern"></div>
        <div class="max-w-[700px] mx-auto px-6 lg:px-8 py-20 lg:py-24 relative z-10">
            <div class="cta-content-modern">
                <h2 class="cta-title-modern">Ready to Make Smarter Decisions?</h2>
                <p class="cta-subtitle-modern">
                    Let's turn your business data into your competitive advantage
                </p>

                <div class="contact-form-modern">
                    <h3 class="form-heading">Get Your Free Business Intelligence Audit</h3>
                    <ContactForm />
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="modern-footer">
        <div class="max-w-[1200px] mx-auto px-6 lg:px-8 py-12 lg:py-16">
            <img src={logoSvg} alt="72° AI Labs logo" class="footer-logo" loading="lazy" decoding="async" />
            <p class="footer-text">&copy; 2025 72° AI LABS. Turning data into decisions since day one.</p>
            <p class="footer-tagline">
                Built for Indian SMBs | Designed for Real Results
            </p>
        </div>
    </footer>

    <script>
        // Smooth scrolling
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });

        // Animate data flow on scroll
        const observerOptions = {
            threshold: 0.3,
            rootMargin: '0px 0px -100px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('animate-in');
                }
            });
        }, observerOptions);

        document.querySelectorAll('.benefit-card, .timeline-step').forEach(el => {
            observer.observe(el);
        });
    </script>
</Layout>

<style>
    /* Modern Header & Navigation */
    .modern-header {
        background: linear-gradient(180deg, var(--brand-cream) 0%, rgba(242, 233, 216, 0.5) 100%);
        padding: 2rem 0 8rem 0;
        position: relative;
        overflow: hidden;
    }

    .nav-modern {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1.5rem 0;
        margin-bottom: 6rem;
    }

    .logo-container {
        display: flex;
        align-items: center;
        gap: 1rem;
        text-decoration: none;
        transition: opacity 0.3s ease;
    }

    .logo-container:hover {
        opacity: 0.9;
    }

    .logo-img {
        height: 4.5rem;
        width: auto;
    }

    .company-name {
        color: var(--brand-blue);
        font-weight: 800;
        font-size: 1.75rem;
        letter-spacing: -0.02em;
        white-space: nowrap;
    }

    .nav-links-modern {
        display: flex;
        gap: 3rem;
        align-items: center;
    }

    .nav-link {
        color: var(--brand-blue);
        text-decoration: none;
        font-weight: 600;
        font-size: 1.05rem;
        transition: color 0.3s ease;
        position: relative;
    }

    .nav-link::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 0;
        height: 2px;
        background: var(--accent-electric);
        transition: width 0.3s ease;
    }

    .nav-link:hover::after {
        width: 100%;
    }

    .nav-link-cta {
        background: var(--gradient-accent);
        color: white;
        padding: 0.75rem 1.75rem;
        border-radius: 50px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0, 153, 255, 0.2);
    }

    .nav-link-cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 25px rgba(0, 153, 255, 0.3);
    }

    /* Hero Section */
    .hero-modern {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: center;
        margin-top: 4rem;
    }

    .hero-content {
        max-width: 600px;
    }

    .hero-title {
        font-size: var(--text-4xl);
        font-weight: 800;
        line-height: 1.1;
        color: var(--brand-blue);
        margin: 0 0 2rem 0;
        letter-spacing: -0.02em;
    }

    .hero-accent {
        background: var(--gradient-accent);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .hero-subtitle {
        font-size: var(--text-lg);
        line-height: 1.7;
        color: rgba(12, 26, 63, 0.75);
        margin: 0 0 3rem 0;
        font-weight: 400;
    }

    .hero-cta-group {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .cta-primary {
        background: var(--gradient-accent);
        color: white;
        padding: 1.125rem 2.5rem;
        border-radius: 50px;
        font-weight: 700;
        font-size: var(--text-lg);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        transition: all 0.3s ease;
        box-shadow: 0 6px 25px rgba(0, 153, 255, 0.25);
    }

    .cta-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 35px rgba(0, 153, 255, 0.35);
    }

    .cta-arrow {
        transition: transform 0.3s ease;
    }

    .cta-primary:hover .cta-arrow {
        transform: translateX(4px);
    }

    .cta-secondary {
        background: transparent;
        color: var(--brand-blue);
        border: 2px solid var(--brand-blue);
        padding: 1.125rem 2.5rem;
        border-radius: 50px;
        font-weight: 700;
        font-size: 1.125rem;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .cta-secondary:hover {
        background: var(--brand-blue);
        color: white;
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(12, 26, 63, 0.2);
    }

    /* Hero Graphic */
    .hero-graphic {
        position: relative;
        padding: 2rem;
    }

    .data-flow-svg {
        width: 100%;
        height: auto;
        filter: drop-shadow(0 4px 20px rgba(0, 217, 255, 0.1));
    }

    /* SVG Animations */
    @keyframes pulse {
        0%, 100% { opacity: 0.8; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.2); }
    }

    @keyframes glow {
        0%, 100% { opacity: 0.8; filter: drop-shadow(0 0 4px #00D9FF); }
        50% { opacity: 1; filter: drop-shadow(0 0 8px #00D9FF); }
    }

    @keyframes flowAnimation {
        0% { stroke-dashoffset: 1000; }
        100% { stroke-dashoffset: 0; }
    }

    .pulse-node {
        animation: pulse 2s ease-in-out infinite;
    }

    .glow-node {
        animation: glow 2s ease-in-out infinite;
    }

    .flow-line {
        stroke-dasharray: 1000;
        stroke-dashoffset: 1000;
        animation: flowAnimation 3s ease-in-out infinite;
    }

    .flow-1 { animation-delay: 0s; }
    .flow-2 { animation-delay: 0.5s; }
    .flow-3 { animation-delay: 1s; }

    /* Benefits Section */
    .benefits-section {
        background: white;
        position: relative;
    }

    .section-header {
        text-align: center;
        margin-bottom: 5rem;
    }

    .section-title-modern {
        font-size: var(--text-3xl);
        font-weight: 800;
        color: var(--brand-blue);
        margin: 0 0 1rem 0;
        letter-spacing: -0.01em;
    }

    .section-subtitle-modern {
        font-size: var(--text-lg);
        color: rgba(12, 26, 63, 0.6);
        font-weight: 500;
    }

    .benefits-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 3rem;
    }

    .benefit-card {
        text-align: center;
        padding: 3rem 2rem;
        border-radius: 16px;
        background: linear-gradient(135deg, rgba(0, 217, 255, 0.02) 0%, rgba(0, 153, 255, 0.05) 100%);
        border: 2px solid rgba(0, 217, 255, 0.1);
        transition: all 0.4s ease;
        opacity: 0;
        transform: translateY(30px);
    }

    .benefit-card.animate-in {
        opacity: 1;
        transform: translateY(0);
    }

    .benefit-card:hover {
        border-color: var(--accent-cyan);
        transform: translateY(-8px);
        box-shadow: 0 12px 40px rgba(0, 217, 255, 0.15);
    }

    .benefit-icon {
        color: var(--accent-electric);
        margin: 0 auto 1.5rem;
        width: 48px;
        height: 48px;
    }

    .benefit-title {
        font-size: var(--text-3xl);
        font-weight: 800;
        color: var(--brand-blue);
        margin: 0 0 0.5rem 0;
    }

    .benefit-desc {
        font-size: var(--text-lg);
        color: rgba(12, 26, 63, 0.7);
        font-weight: 500;
    }

    /* Process Timeline */
    .process-section {
        background: var(--brand-cream);
    }

    .process-timeline {
        max-width: 800px;
        margin: 0 auto;
    }

    .timeline-step {
        display: grid;
        grid-template-columns: 100px 1fr;
        gap: 2rem;
        margin-bottom: 3rem;
        opacity: 0;
        transform: translateX(-30px);
        transition: all 0.5s ease;
    }

    .timeline-step.animate-in {
        opacity: 1;
        transform: translateX(0);
    }

    .step-marker {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .step-number {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: var(--gradient-accent);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        font-weight: 800;
        box-shadow: 0 6px 20px rgba(0, 153, 255, 0.25);
    }

    .step-connector {
        width: 3px;
        flex: 1;
        background: linear-gradient(180deg, var(--accent-cyan) 0%, transparent 100%);
        margin-top: 1rem;
    }

    .timeline-step:last-child .step-connector {
        display: none;
    }

    .step-content-box {
        background: white;
        padding: 2.5rem;
        border-radius: 12px;
        border: 2px solid rgba(0, 217, 255, 0.1);
        transition: all 0.3s ease;
    }

    .step-content-box:hover {
        border-color: var(--accent-cyan);
        box-shadow: 0 8px 30px rgba(0, 217, 255, 0.1);
    }

    .step-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--brand-blue);
        margin: 0 0 1rem 0;
    }

    .step-description {
        font-size: 1.125rem;
        line-height: 1.7;
        color: rgba(12, 26, 63, 0.75);
        margin: 0;
    }

    /* Final CTA Section */
    .final-cta-section {
        background: var(--brand-blue);
        position: relative;
        overflow: hidden;
    }

    .cta-background-pattern {
        position: absolute;
        inset: 0;
        background-image:
            radial-gradient(circle at 20% 50%, rgba(0, 217, 255, 0.1) 0%, transparent 50%),
            radial-gradient(circle at 80% 80%, rgba(0, 153, 255, 0.1) 0%, transparent 50%);
    }

    .cta-content-modern {
        text-align: center;
        color: white;
    }

