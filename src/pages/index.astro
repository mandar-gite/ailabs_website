---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import ContactForm from "../components/ContactForm.astro";
import Footer from "../components/Footer.astro";

const seoTitle = "72° AI LABS — Bespoke AI Systems for Growing Businesses";
const seoDescription = "We build AI systems that work on your actual data — not demos. Custom models, RAG pipelines, intelligent workflows, and decision tools for businesses ready to move beyond spreadsheets.";
const ogImage = "/og-home.jpg";
---

<Layout title={seoTitle} description={seoDescription} ogImage={ogImage}>
    <Nav />

    <main id="main-content">

        <!-- TL;DR for AI crawlers -->
        <p class="sr-only">TL;DR: 72° AI LABS builds custom AI systems for growing businesses. We work on your actual data — Tally exports, call recordings, PDFs, POS feeds — and turn them into working intelligence across finance, operations, and documents. Python-based stack. No vendor lock-in. Frugal by design.</p>

        <!-- Hero -->
        <section class="hero">
            <div class="container">
                <div class="hero-grid">
                    <div class="hero-content">
                        <p class="hero-eyebrow">Bespoke AI, Built to Last</p>
                        <h1 class="hero-heading">
                            Your data.<br/>
                            Your AI system.<br/>
                            <span class="hero-accent">Built to last.</span>
                        </h1>
                        <p class="hero-body">
                            We build AI systems on your actual data — not generic demos.
                            Custom models, intelligent workflows, and decision tools
                            that fit how your business already works.
                        </p>
                        <div class="hero-actions">
                            <a href="/solutions" class="btn-primary">See What We Build</a>
                            <a href="/#contact" class="btn-ghost">Talk to Us</a>
                        </div>
                    </div>

                    <div class="hero-graphic" aria-hidden="true">
                        <div class="graphic-window">
                            <div class="window-bar">
                                <div class="window-dot dot-red"></div>
                                <div class="window-dot dot-amber"></div>
                                <div class="window-dot dot-green"></div>
                            </div>
                            <div class="window-body">
                                <div class="pipeline-label">Data → Intelligence Pipeline</div>
                                <svg class="pipeline-svg" viewBox="0 0 420 220" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <defs>
                                        <linearGradient id="wpFlowIn" x1="0%" y1="0%" x2="100%" y2="0%">
                                            <stop offset="0%" stop-color="#D9A441" stop-opacity="0.25"/>
                                            <stop offset="100%" stop-color="#D9A441" stop-opacity="0.95"/>
                                        </linearGradient>
                                        <linearGradient id="wpFlowOut" x1="0%" y1="0%" x2="100%" y2="0%">
                                            <stop offset="0%" stop-color="#D9A441" stop-opacity="0.95"/>
                                            <stop offset="100%" stop-color="#D9A441" stop-opacity="0.25"/>
                                        </linearGradient>
                                        <filter id="wpGlow" x="-40%" y="-40%" width="180%" height="180%">
                                            <feGaussianBlur stdDeviation="1.7" result="b"/>
                                            <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
                                        </filter>
                                    </defs>
                                    <!-- Source boxes (compact) -->
                                    <rect x="4" y="33" width="84" height="26" rx="7" fill="#F6F7F9" stroke="#E7E3DC" stroke-width="1"/>
                                    <text x="46" y="50" text-anchor="middle" font-family="Plus Jakarta Sans, Inter" font-size="11" font-weight="600" fill="#5B6472">Spreadsheet</text>
                                    <rect x="4" y="97" width="84" height="26" rx="7" fill="#F6F7F9" stroke="#E7E3DC" stroke-width="1"/>
                                    <text x="46" y="114" text-anchor="middle" font-family="Plus Jakarta Sans, Inter" font-size="11" font-weight="600" fill="#5B6472">Documents</text>
                                    <rect x="4" y="161" width="84" height="26" rx="7" fill="#F6F7F9" stroke="#E7E3DC" stroke-width="1"/>
                                    <text x="46" y="178" text-anchor="middle" font-family="Plus Jakarta Sans, Inter" font-size="11" font-weight="600" fill="#5B6472">Live Data</text>
                                    <!-- Flow lines in (thicker + glow) -->
                                    <g filter="url(#wpGlow)">
                                        <path class="line-flow" d="M88 46 Q152 46 188 110" stroke="url(#wpFlowIn)" stroke-width="2.4" stroke-linecap="round"/>
                                        <path class="line-flow" d="M88 110 L188 110" stroke="url(#wpFlowIn)" stroke-width="2.4" stroke-linecap="round"/>
                                        <path class="line-flow" d="M88 174 Q152 174 188 110" stroke="url(#wpFlowIn)" stroke-width="2.4" stroke-linecap="round"/>
                                        <!-- Flow lines out -->
                                        <path class="line-flow" d="M234 98 Q300 46 332 46" stroke="url(#wpFlowOut)" stroke-width="2.4" stroke-linecap="round"/>
                                        <path class="line-flow" d="M238 110 L332 110" stroke="url(#wpFlowOut)" stroke-width="2.4" stroke-linecap="round"/>
                                        <path class="line-flow" d="M234 122 Q300 174 332 174" stroke="url(#wpFlowOut)" stroke-width="2.4" stroke-linecap="round"/>
                                    </g>
                                    <!-- Processing node -->
                                    <circle class="node-pulse" cx="210" cy="110" r="28" fill="#FBF3E2" stroke="#E7C98A" stroke-width="1.5"/>
                                    <circle cx="210" cy="110" r="18" fill="#0C1A3F"/>
                                    <text x="210" y="107" text-anchor="middle" font-family="Plus Jakarta Sans, Inter" font-size="9" font-weight="800" fill="#D9A441">72°</text>
                                    <text x="210" y="118" text-anchor="middle" font-family="Plus Jakarta Sans, Inter" font-size="7" font-weight="700" fill="rgba(217,164,65,0.8)">AI</text>
                                    <!-- Twin gold ripple -->
                                    <circle cx="210" cy="110" r="28" fill="none" stroke="#D9A441" stroke-width="1.4">
                                        <animate attributeName="r" values="28;46" dur="3s" repeatCount="indefinite"/>
                                        <animate attributeName="stroke-opacity" values="0.55;0" dur="3s" repeatCount="indefinite"/>
                                    </circle>
                                    <circle cx="210" cy="110" r="28" fill="none" stroke="#D9A441" stroke-width="1.4">
                                        <animate attributeName="r" values="28;46" dur="3s" begin="1.5s" repeatCount="indefinite"/>
                                        <animate attributeName="stroke-opacity" values="0.55;0" dur="3s" begin="1.5s" repeatCount="indefinite"/>
                                    </circle>
                                    <!-- Output boxes (navy) -->
                                    <rect x="332" y="33" width="84" height="26" rx="7" fill="#0C1A3F"/>
                                    <text x="374" y="50" text-anchor="middle" font-family="Plus Jakarta Sans, Inter" font-size="11" font-weight="600" fill="#FFFFFF">Forecasts</text>
                                    <rect x="332" y="97" width="84" height="26" rx="7" fill="#0C1A3F"/>
                                    <text x="374" y="114" text-anchor="middle" font-family="Plus Jakarta Sans, Inter" font-size="11" font-weight="600" fill="#FFFFFF">Insights</text>
                                    <rect x="332" y="161" width="84" height="26" rx="7" fill="#0C1A3F"/>
                                    <text x="374" y="178" text-anchor="middle" font-family="Plus Jakarta Sans, Inter" font-size="11" font-weight="600" fill="#FFFFFF">Decisions</text>
                                </svg>
                                <div class="window-badges">
                                    <span class="badge"><span class="badge-dot"></span>Your Data. Your Rules.</span>
                                    <span class="badge"><span class="badge-dot"></span>Open Source Models</span>
                                    <span class="badge"><span class="badge-dot"></span>Host in Your Cloud</span>
                                    <span class="badge"><span class="badge-dot"></span>No Subscription Fees</span>
                                </div>
                            </div>
                        </div>
                        <div class="float-metric">
                            <div class="metric-num">100%</div>
                            <div class="metric-label">Custom-built<br/>for your stack</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Trust bar -->
        <section class="trust-bar">
            <div class="container">
                <p class="trust-label">Deployed across</p>
                <div class="trust-items">
                    <span>Manufacturing</span>
                    <span class="sep">·</span>
                    <span>Food & Beverage</span>
                    <span class="sep">·</span>
                    <span>Retail & Distribution</span>
                    <span class="sep">·</span>
                    <span>Professional Services</span>
                    <span class="sep">·</span>
                    <span>Logistics</span>
                </div>
            </div>
        </section>

        <!-- Capabilities -->
        <section class="capabilities">
            <div class="container">
                <div class="section-header">
                    <h2>What we build</h2>
                    <p>AI that answers the questions keeping you up at night</p>
                </div>

                <div class="cap-grid">
                    <div class="cap-card">
                        <div class="cap-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
                        </div>
                        <div class="cap-label">Finance</div>
                        <h3>Know where the money's going — before month-end</h3>
                        <p>AI that tracks cash flow, flags anomalies, and surfaces the numbers that actually matter to your business.</p>
                    </div>

                    <div class="cap-card">
                        <div class="cap-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                        </div>
                        <div class="cap-label">Operations</div>
                        <h3>Spot bottlenecks before they cost you</h3>
                        <p>Real-time visibility into production, inventory, and fulfilment — with AI-flagged issues before they escalate.</p>
                    </div>

                    <div class="cap-card">
                        <div class="cap-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
                        </div>
                        <div class="cap-label">Sales</div>
                        <h3>Know which deals will close — and which won't</h3>
                        <p>Pipeline intelligence that surfaces high-value opportunities and tells your team where to focus this week.</p>
                    </div>

                    <div class="cap-card">
                        <div class="cap-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                        </div>
                        <div class="cap-label">Customer Support</div>
                        <h3>Answer every customer query — in seconds</h3>
                        <p>Intelligent assistants trained on your products, policies, and past conversations. No outsourcing required.</p>
                    </div>

                    <div class="cap-card">
                        <div class="cap-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h18v18H3z"/><path d="M3 9h18M9 21V9"/></svg>
                        </div>
                        <div class="cap-label">Marketing</div>
                        <h3>Know which campaign is working — and which is wasting budget</h3>
                        <p>Attribution and performance analytics that connect spend to revenue, not just clicks and impressions.</p>
                    </div>

                    <div class="cap-card">
                        <div class="cap-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 17H3a2 2 0 01-2-2V5a2 2 0 012-2h11a2 2 0 012 2v3"/><rect x="9" y="11" width="14" height="10" rx="1"/><path d="M13 15.5h.01M17 15.5h.01"/></svg>
                        </div>
                        <div class="cap-label">Logistics</div>
                        <h3>Know where your shipment is — before your customer asks</h3>
                        <p>End-to-end tracking, delay prediction, and automated alerts that keep your supply chain moving.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- How It Works -->
        <section class="process">
            <div class="container">
                <div class="section-header">
                    <h2>How we work</h2>
                    <p>A bespoke engagement — from first conversation to a system you own</p>
                </div>

                <div class="steps">
                    <div class="step">
                        <div class="step-num">01</div>
                        <div class="step-body">
                            <h3>Discovery — we map the problem worth solving</h3>
                            <p>We start with your business, not a demo. Together we find where decisions stall, what data you already have, and the one outcome that would move the needle most. You leave with a clear, prioritised scope — before anyone writes code.</p>
                        </div>
                    </div>

                    <div class="step">
                        <div class="step-num">02</div>
                        <div class="step-body">
                            <h3>Proof of concept — we prove value on your real data</h3>
                            <p>We build a working prototype on your actual data and put it in front of you fast. You see real output against a concrete success measure, so you can judge the value — and the fit — before committing to a full build.</p>
                        </div>
                    </div>

                    <div class="step">
                        <div class="step-num">03</div>
                        <div class="step-body">
                            <h3>Implementation — we harden it into a system you own</h3>
                            <p>Once the PoC earns its place, we engineer it into a production system: integrated with your tools, documented, and handed over with full ownership. No lock-in, and a foundation that keeps getting smarter as your business grows.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Proof -->
        <section class="proof">
            <div class="container">
                <div class="stats-grid">
                    <div class="stat">
                        <div class="stat-num">5+</div>
                        <div class="stat-label">Industries served</div>
                    </div>
                    <div class="stat">
                        <div class="stat-num">100%</div>
                        <div class="stat-label">Built on your actual data — not pre-trained demos</div>
                    </div>
                    <div class="stat">
                        <div class="stat-num">0</div>
                        <div class="stat-label">Migrations required to get started</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA / Contact -->
        <section class="cta-section" id="contact">
            <div class="container">
                <div class="cta-inner">
                    <div class="cta-text">
                        <h2>Not a demo. Not a template.<br/>A system built for your business.</h2>
                        <p>Tell us what's not working. We'll tell you if AI can fix it — and what that looks like in practice.</p>
                        <ul class="cta-points">
                            <li>Free initial assessment</li>
                            <li>No vendor lock-in</li>
                            <li>You own the system</li>
                        </ul>
                    </div>
                    <div class="cta-form-wrap">
                        <h3>Get in touch</h3>
                        <ContactForm />
                    </div>
                </div>
            </div>
        </section>

    </main>

    <Footer />

</Layout>

<style>
    /* Layout */
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    /* Hero */
    .hero {
        position: relative;
        padding: 6rem 0 5rem;
        background: var(--bg);
        overflow: hidden;
    }

    .hero::before {
        content: "";
        position: absolute;
        top: -25%;
        right: -8%;
        width: 46vw;
        height: 46vw;
        max-width: 640px;
        max-height: 640px;
        background: radial-gradient(circle, rgba(217,164,65,0.13), rgba(217,164,65,0) 62%);
        pointer-events: none;
        z-index: 0;
    }

    .hero .container { position: relative; z-index: 1; }

    .hero-grid {
        display: grid;
        grid-template-columns: 55fr 45fr;
        gap: 4rem;
        align-items: center;
    }

    /* Override the legacy home.css `.hero { text-align:center }` leak */
    .hero-content { text-align: left; }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.74rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--wp-gold-deep);
        background: var(--wp-gold-tint);
        padding: 0.4rem 0.8rem;
        border-radius: 999px;
        margin: 0 0 1.4rem;
    }

    .hero-heading {
        font-size: clamp(2.7rem, 5.2vw, 4.25rem);
        font-weight: 800;
        line-height: 1.03;
        color: var(--wp-ink);
        letter-spacing: -0.04em;
        margin: 0 0 1.4rem;
    }

    .hero-accent {
        color: var(--wp-gold-deep);
    }

    .hero-body {
        font-size: var(--text-lg);
        color: var(--wp-ink-2);
        line-height: 1.7;
        margin: 0 0 2.4rem;
        max-width: 520px;
        text-align: justify;
    }

    .hero-actions {
        display: flex;
        gap: 0.85rem;
        flex-wrap: wrap;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        background: #fff;
        color: var(--wp-ink);
        font-weight: 700;
        font-size: 0.9375rem;
        padding: 0.9rem 1.75rem;
        border-radius: 14px;
        border: 1.5px solid var(--wp-ink);
        text-decoration: none;
        box-shadow: var(--shadow-sm);
        transition: background 0.15s, color 0.15s, transform 0.15s;
    }

    .btn-primary:hover {
        background: var(--wp-ink);
        color: #fff;
        transform: translateY(-2px);
    }

    .btn-ghost {
        display: inline-flex;
        align-items: center;
        background: #fff;
        color: var(--wp-ink);
        font-weight: 700;
        font-size: 0.9375rem;
        padding: 0.9rem 1.75rem;
        border-radius: 14px;
        border: 1px solid var(--wp-line-2);
        text-decoration: none;
        box-shadow: var(--shadow-sm);
        transition: border-color 0.15s, transform 0.15s;
    }

    .btn-ghost:hover {
        border-color: var(--wp-ink-2);
        transform: translateY(-2px);
    }

    /* Pipeline graphic */
    .hero-graphic {
        position: relative;
    }

    .graphic-window {
        background: #fff;
        border: 1px solid var(--wp-line);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-xl);
        overflow: hidden;
    }

    .window-bar {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.875rem 1.25rem;
        border-bottom: 1px solid var(--wp-line);
        background: var(--wp-canvas-2);
    }

    .window-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .dot-red   { background: #FF5F57; }
    .dot-amber { background: #FEBC2E; }
    .dot-green { background: #28C840; }

    .window-body {
        padding: 1.5rem;
    }

    .pipeline-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--wp-ink-3);
        margin-bottom: 1.25rem;
    }

    .pipeline-svg {
        width: 100%;
        height: auto;
    }

    .node-pulse {
        animation: node-breathe 3s ease-in-out infinite;
    }

    @keyframes node-breathe {
        0%, 100% { opacity: 0.6; }
        50% { opacity: 1; }
    }

    .line-flow {
        stroke-dasharray: 160;
        stroke-dashoffset: 160;
        animation: flow 2s ease-in-out infinite;
    }

    .line-flow:nth-child(2) { animation-delay: 0.4s; }
    .line-flow:nth-child(3) { animation-delay: 0.8s; }
    .line-flow:nth-child(5) { animation-delay: 0.4s; }
    .line-flow:nth-child(6) { animation-delay: 0.8s; }

    @keyframes flow {
        0%   { stroke-dashoffset: 160; opacity: 0.2; }
        50%  { stroke-dashoffset: 0;   opacity: 1; }
        100% { stroke-dashoffset: -160; opacity: 0.2; }
    }

    .window-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1.25rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--wp-line);
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: var(--wp-canvas-2);
        border: 1px solid var(--wp-line);
        border-radius: 999px;
        padding: 0.32rem 0.7rem;
        font-size: 0.73rem;
        font-weight: 600;
        color: var(--wp-ink-2);
    }

    .badge-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--wp-gold);
        flex-shrink: 0;
    }

    .float-metric {
        position: absolute;
        bottom: 1rem;
        right: -1.25rem;
        background: var(--wp-navy);
        color: #fff;
        border-radius: var(--radius);
        padding: 1rem 1.25rem;
        box-shadow: var(--shadow-lg);
        animation: float 5s ease-in-out infinite;
        min-width: 130px;
    }

    @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-8px); }
    }

    .metric-num {
        font-size: 1.75rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1;
        color: var(--wp-gold);
    }

    .metric-label {
        font-size: 0.7rem;
        font-weight: 500;
        opacity: 0.85;
        margin-top: 0.25rem;
        line-height: 1.4;
    }

    /* Trust bar */
    .trust-bar {
        border-top: 1px solid var(--wp-line);
        border-bottom: 1px solid var(--wp-line);
        padding: 1.25rem 0;
        background: #fff;
    }

    .trust-bar .container {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .trust-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--wp-ink-3);
        white-space: nowrap;
        margin: 0;
    }

    .trust-items {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--wp-ink-2);
    }

    .trust-items .sep {
        color: var(--wp-gold);
    }

    /* Capabilities */
    .capabilities {
        padding: 6.5rem 0;
        background: var(--bg);
    }

    .section-header {
        text-align: left;
        max-width: 40rem;
        margin: 0 0 3.5rem;
    }

    .section-header h2 {
        font-size: clamp(2rem, 3.4vw, 2.75rem);
        font-weight: 800;
        color: var(--wp-ink);
        margin: 0 0 0.75rem;
        letter-spacing: -0.03em;
    }

    .section-header p {
        font-size: var(--text-lg);
        color: var(--wp-ink-2);
        margin: 0;
    }

    .cap-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    .cap-card {
        position: relative;
        overflow: hidden;
        background: #fff;
        border: 1px solid var(--wp-line);
        border-radius: 20px;
        padding: 2rem;
        box-shadow: var(--shadow-sm);
        transition: box-shadow 0.22s, border-color 0.22s, transform 0.22s;
    }

    .cap-card::after {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: var(--wp-gold);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.32s cubic-bezier(.2,.7,.2,1);
    }

    .cap-card:hover {
        box-shadow: var(--shadow-lg);
        border-color: var(--wp-line-2);
        transform: translateY(-5px);
    }

