---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import ContactForm from "../components/ContactForm.astro";
import Footer from "../components/Footer.astro";

const seoTitle = "72° AI LABS — Bespoke AI Systems for Growing Businesses";
const seoDescription = "We build AI systems that work on your actual data — not demos. Custom models, RAG pipelines, intelligent workflows, and decision tools for businesses ready to move beyond spreadsheets.";
const ogImage = "/og-home.jpg";
---

<Layout title={seoTitle} description={seoDescription} ogImage={ogImage}>
    <Nav />

    <main id="main-content">

        <!-- Hero -->
        <section class="hero">
            <div class="container">
                <div class="hero-grid">
                    <div class="hero-content">
                        <p class="hero-eyebrow">Building in India for the World</p>
                        <h1 class="hero-heading">
                            Your data.<br/>
                            <span class="hero-accent">Your AI system.</span><br/>
                            Built to last.
                        </h1>
                        <p class="hero-body">
                            We build AI systems on your actual data — not generic demos.
                            Custom models, intelligent workflows, and decision tools
                            that fit how your business already works.
                        </p>
                        <div class="hero-actions">
                            <a href="/solutions" class="btn-primary">See What We Build</a>
                            <a href="/#contact" class="btn-ghost">Talk to Us</a>
                        </div>
                    </div>

                    <div class="hero-graphic" aria-hidden="true">
                        <div class="graphic-window">
                            <div class="window-bar">
                                <div class="window-dot dot-red"></div>
                                <div class="window-dot dot-amber"></div>
                                <div class="window-dot dot-green"></div>
                            </div>
                            <div class="window-body">
                                <div class="pipeline-label">Data → Intelligence Pipeline</div>
                                <svg class="pipeline-svg" viewBox="0 0 420 220" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <defs>
                                        <linearGradient id="lg1" x1="0%" y1="0%" x2="100%" y2="0%">
                                            <stop offset="0%" stop-color="#2563EB" stop-opacity="0.3"/>
                                            <stop offset="100%" stop-color="#2563EB" stop-opacity="0.9"/>
                                        </linearGradient>
                                    </defs>
                                    <!-- Source boxes -->
                                    <rect x="8" y="32" width="76" height="28" rx="6" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1"/>
                                    <text x="46" y="51" text-anchor="middle" font-family="Inter" font-size="9.5" font-weight="600" fill="#475569">Spreadsheet</text>
                                    <rect x="8" y="96" width="76" height="28" rx="6" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1"/>
                                    <text x="46" y="115" text-anchor="middle" font-family="Inter" font-size="9.5" font-weight="600" fill="#475569">Documents</text>
                                    <rect x="8" y="160" width="76" height="28" rx="6" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1"/>
                                    <text x="46" y="179" text-anchor="middle" font-family="Inter" font-size="9.5" font-weight="600" fill="#475569">Live Data</text>
                                    <!-- Flow lines in -->
                                    <path class="line-flow" d="M84 46 Q180 46 196 110" stroke="url(#lg1)" stroke-width="1.5" stroke-linecap="round"/>
                                    <path class="line-flow" d="M84 110 Q140 110 196 110" stroke="url(#lg1)" stroke-width="1.5" stroke-linecap="round"/>
                                    <path class="line-flow" d="M84 174 Q180 174 196 110" stroke="url(#lg1)" stroke-width="1.5" stroke-linecap="round"/>
                                    <!-- Processing node -->
                                    <circle class="node-pulse" cx="212" cy="110" r="28" fill="#EFF6FF" stroke="#BFDBFE" stroke-width="1.5"/>
                                    <circle cx="212" cy="110" r="18" fill="#2563EB"/>
                                    <text x="212" y="106" text-anchor="middle" font-family="Inter" font-size="7.5" font-weight="800" fill="white">72°</text>
                                    <text x="212" y="118" text-anchor="middle" font-family="Inter" font-size="7" font-weight="600" fill="rgba(255,255,255,0.7)">AI</text>
                                    <!-- Ripple -->
                                    <circle cx="212" cy="110" r="28" fill="none" stroke="#2563EB" stroke-width="1">
                                        <animate attributeName="r" values="28;42;28" dur="3s" repeatCount="indefinite"/>
                                        <animate attributeName="stroke-opacity" values="0.4;0;0.4" dur="3s" repeatCount="indefinite"/>
                                    </circle>
                                    <!-- Flow lines out — evenly spaced to match inputs -->
                                    <path class="line-flow" d="M230 97 Q300 46 336 46" stroke="url(#lg1)" stroke-width="1.5" stroke-linecap="round"/>
                                    <path class="line-flow" d="M240 110 Q300 110 336 110" stroke="url(#lg1)" stroke-width="1.5" stroke-linecap="round"/>
                                    <path class="line-flow" d="M230 123 Q300 174 336 174" stroke="url(#lg1)" stroke-width="1.5" stroke-linecap="round"/>
                                    <!-- Output boxes — evenly spaced -->
                                    <rect x="336" y="32" width="76" height="28" rx="6" fill="#2563EB"/>
                                    <text x="374" y="51" text-anchor="middle" font-family="Inter" font-size="9.5" font-weight="600" fill="white">Forecasts</text>
                                    <rect x="336" y="96" width="76" height="28" rx="6" fill="#2563EB"/>
                                    <text x="374" y="115" text-anchor="middle" font-family="Inter" font-size="9.5" font-weight="600" fill="white">Insights</text>
                                    <rect x="336" y="160" width="76" height="28" rx="6" fill="#2563EB"/>
                                    <text x="374" y="179" text-anchor="middle" font-family="Inter" font-size="9.5" font-weight="600" fill="white">Decisions</text>
                                </svg>
                                <div class="window-badges">
                                    <span class="badge"><span class="badge-dot"></span>Your Data. Your Rules.</span>
                                    <span class="badge"><span class="badge-dot"></span>Open Source Models</span>
                                    <span class="badge"><span class="badge-dot"></span>Host in Your Cloud</span>
                                    <span class="badge"><span class="badge-dot"></span>No Subscription Fees</span>
                                </div>
                            </div>
                        </div>
                        <div class="float-metric">
                            <div class="metric-num">100%</div>
                            <div class="metric-label">Custom-built<br/>for your stack</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Trust bar -->
        <section class="trust-bar">
            <div class="container">
                <p class="trust-label">Deployed across</p>
                <div class="trust-items">
                    <span>Manufacturing</span>
                    <span class="sep">·</span>
                    <span>Food & Beverage</span>
                    <span class="sep">·</span>
                    <span>Retail & Distribution</span>
                    <span class="sep">·</span>
                    <span>Professional Services</span>
                    <span class="sep">·</span>
                    <span>Logistics</span>
                </div>
            </div>
        </section>

        <!-- Capabilities -->
        <section class="capabilities">
            <div class="container">
                <div class="section-header">
                    <h2>What we build</h2>
                    <p>AI that answers the questions keeping you up at night</p>
                </div>

                <div class="cap-grid">
                    <div class="cap-card">
                        <div class="cap-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
                        </div>
                        <div class="cap-label">Finance</div>
                        <h3>Know where every rupee is going — before month-end</h3>
                        <p>AI that tracks cash flow, flags anomalies, and surfaces the numbers that actually matter to your business.</p>
                    </div>

                    <div class="cap-card">
                        <div class="cap-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                        </div>
                        <div class="cap-label">Operations</div>
                        <h3>Spot bottlenecks before they cost you</h3>
                        <p>Real-time visibility into production, inventory, and fulfilment — with AI-flagged issues before they escalate.</p>
                    </div>

                    <div class="cap-card">
                        <div class="cap-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
                        </div>
                        <div class="cap-label">Sales</div>
                        <h3>Know which deals will close — and which won't</h3>
                        <p>Pipeline intelligence that surfaces high-value opportunities and tells your team where to focus this week.</p>
                    </div>

                    <div class="cap-card">
                        <div class="cap-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg>
                        </div>
                        <div class="cap-label">Customer Support</div>
                        <h3>Answer every customer query — in seconds</h3>
                        <p>Intelligent assistants trained on your products, policies, and past conversations. No outsourcing required.</p>
                    </div>

                    <div class="cap-card">
                        <div class="cap-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3h18v18H3z"/><path d="M3 9h18M9 21V9"/></svg>
                        </div>
                        <div class="cap-label">Marketing</div>
                        <h3>Know which campaign is working — and which is wasting budget</h3>
                        <p>Attribution and performance analytics that connect spend to revenue, not just clicks and impressions.</p>
                    </div>

                    <div class="cap-card">
                        <div class="cap-icon">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 17H3a2 2 0 01-2-2V5a2 2 0 012-2h11a2 2 0 012 2v3"/><rect x="9" y="11" width="14" height="10" rx="1"/><path d="M13 15.5h.01M17 15.5h.01"/></svg>
                        </div>
                        <div class="cap-label">Logistics</div>
                        <h3>Know where your shipment is — before your customer asks</h3>
                        <p>End-to-end tracking, delay prediction, and automated alerts that keep your supply chain moving.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- How It Works -->
        <section class="process">
            <div class="container">
                <div class="section-header">
                    <h2>How it works</h2>
                    <p>From your existing data to a running AI system</p>
                </div>

                <div class="steps">
                    <div class="step">
                        <div class="step-num">01</div>
                        <div class="step-body">
                            <h3>We connect to your existing systems</h3>
                            <p>ERP, CRM, spreadsheets, databases — wherever your data lives. No migration, no disruption to what's already working.</p>
                        </div>
                    </div>

                    <div class="step">
                        <div class="step-num">02</div>
                        <div class="step-body">
                            <h3>Our models learn your business</h3>
                            <p>We train on your data, your terminology, your processes. The result speaks your language, not generic AI language.</p>
                        </div>
                    </div>

                    <div class="step">
                        <div class="step-num">03</div>
                        <div class="step-body">
                            <h3>You get a system built for you</h3>
                            <p>A purpose-built AI system, tested on your real data and handed over ready to run. Full documentation, full ownership.</p>
                        </div>
                    </div>

                    <div class="step">
                        <div class="step-num">04</div>
                        <div class="step-body">
                            <h3>We stay as it evolves</h3>
                            <p>Ongoing support as your business grows. New data sources, new questions, new capabilities — we grow with you.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Proof -->
        <section class="proof">
            <div class="container">
                <div class="stats-grid">
                    <div class="stat">
                        <div class="stat-num">5+</div>
                        <div class="stat-label">Industries served across three continents</div>
                    </div>
                    <div class="stat">
                        <div class="stat-num">100%</div>
                        <div class="stat-label">Built on your actual data — not pre-trained demos</div>
                    </div>
                    <div class="stat">
                        <div class="stat-num">0</div>
                        <div class="stat-label">Migrations required to get started</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA / Contact -->
        <section class="cta-section" id="contact">
            <div class="container">
                <div class="cta-inner">
                    <div class="cta-text">
                        <h2>Not a demo. Not a template.<br/>A system built for your business.</h2>
                        <p>Tell us what's not working. We'll tell you if AI can fix it — and what that looks like in practice.</p>
                        <ul class="cta-points">
                            <li>Free initial assessment</li>
                            <li>No vendor lock-in</li>
                            <li>You own the system</li>
                        </ul>
                    </div>
                    <div class="cta-form-wrap">
                        <h3>Get in touch</h3>
                        <ContactForm />
                    </div>
                </div>
            </div>
        </section>

    </main>

    <Footer />

</Layout>

<style>
    /* Layout */
    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
    }

    /* Hero */
    .hero {
        padding: 5rem 0 4rem;
        background: var(--bg);
    }

    .hero-grid {
        display: grid;
        grid-template-columns: 55fr 45fr;
        gap: 4rem;
        align-items: center;
    }

    .hero-eyebrow {
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--accent);
        margin: 0 0 1.25rem;
    }

    .hero-heading {
        font-size: var(--text-5xl);
        font-weight: 800;
        line-height: 1.1;
        color: var(--text);
        letter-spacing: -0.02em;
        margin: 0 0 1.5rem;
    }

    .hero-accent {
        color: var(--accent);
    }

    .hero-body {
        font-size: var(--text-lg);
        color: var(--text-2);
        line-height: 1.7;
        margin: 0 0 2.5rem;
        max-width: 520px;
    }

    .hero-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .btn-primary {
        display: inline-flex;
        align-items: center;
        background: var(--accent);
        color: #fff;
        font-weight: 700;
        font-size: 0.9375rem;
        padding: 0.875rem 1.75rem;
        border-radius: var(--radius-sm);
        text-decoration: none;
        transition: background 0.15s;
    }

    .btn-primary:hover {
        background: var(--accent-hover);
    }

    .btn-ghost {
        display: inline-flex;
        align-items: center;
        background: transparent;
        color: var(--text);
        font-weight: 600;
        font-size: 0.9375rem;
        padding: 0.875rem 1.75rem;
        border-radius: var(--radius-sm);
        border: 1.5px solid var(--border);
        text-decoration: none;
        transition: border-color 0.15s, background 0.15s;
    }

    .btn-ghost:hover {
        border-color: var(--border-hover);
        background: var(--surface);
    }

    /* Pipeline graphic */
    .hero-graphic {
        position: relative;
    }

    .graphic-window {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-xl);
        overflow: hidden;
    }

    .window-bar {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.875rem 1.25rem;
        border-bottom: 1px solid var(--border);
        background: var(--surface);
    }

    .window-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
    }

    .dot-red   { background: #FF5F57; }
    .dot-amber { background: #FEBC2E; }
    .dot-green { background: #28C840; }

    .window-body {
        padding: 1.5rem;
    }

    .pipeline-label {
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-3);
        margin-bottom: 1.25rem;
    }

    .pipeline-svg {
        width: 100%;
        height: auto;
    }

    .node-pulse {
        animation: node-breathe 3s ease-in-out infinite;
    }

    @keyframes node-breathe {
        0%, 100% { opacity: 0.6; }
        50% { opacity: 1; }
    }

    .line-flow {
        stroke-dasharray: 160;
        stroke-dashoffset: 160;
        animation: flow 2s ease-in-out infinite;
    }

    .line-flow:nth-child(2) { animation-delay: 0.4s; }
    .line-flow:nth-child(3) { animation-delay: 0.8s; }

    @keyframes flow {
        0%   { stroke-dashoffset: 160; opacity: 0.2; }
        50%  { stroke-dashoffset: 0;   opacity: 1; }
        100% { stroke-dashoffset: -160; opacity: 0.2; }
    }

    .window-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1.25rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--border);
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.3rem 0.65rem;
        font-size: 0.73rem;
        font-weight: 600;
        color: var(--text-2);
    }

    .badge-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #22C55E;
        flex-shrink: 0;
    }

    .float-metric {
        position: absolute;
        bottom: 1rem;
        right: -1.25rem;
        background: var(--accent);
        color: #fff;
        border-radius: var(--radius);
        padding: 1rem 1.25rem;
        box-shadow: var(--shadow-lg);
        animation: float 5s ease-in-out infinite;
        min-width: 130px;
    }

    @keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-8px); }
    }

    .metric-num {
        font-size: 1.75rem;
        font-weight: 900;
        letter-spacing: -0.03em;
        line-height: 1;
    }

    .metric-label {
        font-size: 0.7rem;
        font-weight: 500;
        opacity: 0.85;
        margin-top: 0.25rem;
        line-height: 1.4;
    }

    /* Trust bar */
    .trust-bar {
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        padding: 1.25rem 0;
        background: var(--surface);
    }

    .trust-bar .container {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .trust-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-3);
        white-space: nowrap;
        margin: 0;
    }

    .trust-items {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--text-2);
    }

    .trust-items .sep {
        color: var(--border-hover);
    }

    /* Capabilities */
    .capabilities {
        padding: 5rem 0;
        background: var(--bg);
    }

    .section-header {
        text-align: center;
        margin-bottom: 3rem;
    }

    .section-header h2 {
        font-size: var(--text-3xl);
        font-weight: 700;
        color: var(--text);
        margin: 0 0 0.75rem;
        letter-spacing: -0.01em;
    }

    .section-header p {
        font-size: var(--text-lg);
        color: var(--text-2);
        margin: 0;
    }

    .cap-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    .cap-card {
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.75rem;
        transition: box-shadow 0.2s, border-color 0.2s;
    }

    .cap-card:hover {
        box-shadow: var(--shadow-md);
        border-color: var(--border-hover);
    }

    .cap-icon {
        width: 40px;
        height: 40px;
        background: var(--accent-light);
        border-radius: var(--radius-sm);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent);
        margin-bottom: 1rem;
    }

    .cap-label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-3);
        margin-bottom: 0.5rem;
    }

    .cap-card h3 {
        font-size: 0.9375rem;
        font-weight: 700;
        color: var(--text);
        margin: 0 0 0.75rem;
        line-height: 1.4;
    }

    .cap-card p {
        font-size: 0.875rem;
        color: var(--text-2);
        line-height: 1.6;
        margin: 0;
    }

    /* Process */
    .process {
        padding: 5rem 0;
        background: var(--surface);
    }

    .steps {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
        max-width: 900px;
        margin: 0 auto;
    }

    .step {
        display: flex;
        gap: 1.25rem;
        align-items: flex-start;
    }

    .step-num {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--accent);
        color: #fff;
        font-size: 0.8125rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .step-body h3 {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text);
        margin: 0 0 0.5rem;
        line-height: 1.4;
    }

    .step-body p {
        font-size: 0.875rem;
        color: var(--text-2);
        line-height: 1.6;
        margin: 0;
    }

    /* Proof */
    .proof {
        padding: 4rem 0;
        background: var(--bg);
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        text-align: center;
    }

    .stat-num {
        font-size: var(--text-4xl);
        font-weight: 800;
        color: var(--text);
        letter-spacing: -0.02em;
        line-height: 1;
        margin-bottom: 0.5rem;
    }

    .stat-label {
        font-size: 0.875rem;
        color: var(--text-2);
        line-height: 1.4;
    }

    /* CTA / Contact */
    .cta-section {
        padding: 5rem 0;
        background: var(--surface);
    }

    .cta-inner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4rem;
        align-items: start;
    }

    .cta-text h2 {
        font-size: var(--text-3xl);
        font-weight: 700;
        color: var(--text);
        margin: 0 0 1rem;
        letter-spacing: -0.01em;
        line-height: 1.25;
    }

    .cta-text p {
        font-size: var(--text-base);
