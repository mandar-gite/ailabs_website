---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import PageHeader from "../../components/PageHeader.astro";
import projectsData from "../../data/projects.json";
import type { Project } from "../../types";
import { getCollection } from "astro:content";

const cases = (await getCollection("case-studies", ({ data }) => data.draft !== true))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const projectOf = (id: string) => (projectsData as Project[]).find((p) => p.id === id);
---

<Layout title="AI case studies on a business's own data | 72° AI LABS" description="What we built for an education NGO and a due-diligence firm, the hard part, and what changed for them. Each links to the project's technical detail.">
  <Nav />
  <main id="main-content" class="cases-page">
    <div class="max-w-[1000px] mx-auto px-6 lg:px-8 py-8 lg:py-10">
      <PageHeader title="AI case studies" intro="The problem each client had, what we built, and what changed. The technical detail is on each project page." />
      <ul class="case-list">
        {cases.map((c) => (
          <li>
            <a href={`/case-studies/${c.slug}/`} class="case-card">
              <span class="case-category">{projectOf(c.data.project)?.category}</span>
              <span class="case-title">{c.data.title}</span>
              <span class="case-desc">{c.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .cases-page { background: var(--brand-cream); min-height: 100vh; }
  .case-list { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1.25rem; }
  .case-card { display: block; background: white; border: 2px solid rgba(12, 26, 63, 0.1); border-radius: 8px; padding: 1.5rem; text-decoration: none; transition: border-color 0.2s ease; }
  .case-card:hover { border-color: var(--wp-gold); }
  .case-category { display: block; font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--wp-ink-2); margin-bottom: 0.5rem; }
  .case-title { display: block; font-size: 1.25rem; font-weight: 700; color: var(--brand-blue); line-height: 1.35; margin-bottom: 0.5rem; }
  .case-desc { display: block; color: var(--wp-ink-2); line-height: 1.6; }
</style>
