---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const blogPosts = await getCollection("blog", ({ data }) => {
    return data.draft !== true;
  });

  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await post.render();

// Format date helper
function formatDate(date: Date): string {
  return date.toLocaleDateString("en-IN", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

const seoTitle = `${post.data.title} | 72° AI Labs Blog`;
const seoDescription = post.data.description;
// Use post-specific OG image if available, otherwise use blog default
const ogImage = post.data.image || "/og-blog.jpg";
const canonicalURL = new URL(`/blog/${post.slug}`, Astro.site).href;
const ogImageURL = new URL(ogImage, Astro.site).href;

const articleMeta = {
  publishedTime: post.data.pubDate.toISOString(),
  modifiedTime: post.data.updatedDate?.toISOString(),
  author: post.data.author || "Mandar Gite",
  tags: post.data.tags,
};

const blogPostingLD = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "image": ogImageURL,
  "datePublished": post.data.pubDate.toISOString(),
  ...(post.data.updatedDate && { "dateModified": post.data.updatedDate.toISOString() }),
  "author": {
    "@type": "Person",
    "name": post.data.author || "Mandar Gite",
    "url": "https://72ai.in"
  },
  "publisher": {
    "@type": "Organization",
    "name": "72° AI LABS",
    "logo": {
      "@type": "ImageObject",
      "url": "https://72ai.in/favicon.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL
  },
  ...(post.data.tags && { "keywords": post.data.tags.join(", ") })
};

const faqLD = post.data.faq?.length ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": post.data.faq.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;

const breadcrumbLD = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://72ai.in" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://72ai.in/blog" },
    { "@type": "ListItem", "position": 3, "name": post.data.title, "item": canonicalURL }
  ]
};
---

<Layout title={seoTitle} description={seoDescription} ogImage={ogImage} pageType="article" articleMeta={articleMeta}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogPostingLD)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLD)} />
    {faqLD && <script type="application/ld+json" set:html={JSON.stringify(faqLD)} />}
  </Fragment>
  <Nav />
  <main class="blog-post-page">
    <article class="blog-post">
      <div class="max-w-[800px] mx-auto px-6 lg:px-8 py-8 lg:py-10">

        <!-- Post Header -->
        <header class="post-header">
          <div class="post-meta">
            <span class="post-category">{post.data.category}</span>
            {post.data.featured && <span class="featured-badge">Featured</span>}
          </div>
          <h1 class="post-title">{post.data.title}</h1>
          <p class="post-description">{post.data.description}</p>
          <div class="post-info">
            <span class="post-author">By {post.data.author}</span>
            <span class="separator">•</span>
            <time class="post-date" datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
          </div>
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="post-tags">
              {post.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          )}
        </header>

        <!-- Post Content -->
        <div class="post-content">
          <Content />
        </div>

        <!-- Post Footer -->
        <footer class="post-footer">
          <a href="/blog" class="back-link">← Back to Blog</a>
          <a href="/#contact" class="contact-link">Get in Touch</a>
        </footer>

      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .blog-post-page {
    background: var(--brand-cream);
    min-height: 100vh;
  }

  .blog-post {
    background: white;
    min-height: 100vh;
  }

  .post-header {
    text-align: center;
    padding-bottom: 3rem;
    border-bottom: 2px solid rgba(12, 26, 63, 0.1);
    margin-bottom: 3rem;
  }

  .post-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .post-category {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--brand-gold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .featured-badge {
    background: var(--brand-gold);
    color: white;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .post-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    color: var(--brand-blue);
    margin: 0 0 1.5rem 0;
    line-height: 1.2;
  }

  .post-description {
    font-size: var(--text-xl);
    color: rgba(12, 26, 63, 0.75);
    margin: 0 0 2rem 0;
    line-height: 1.6;
    font-weight: 500;
  }

  .post-info {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: center;
    font-size: 0.95rem;
    color: rgba(12, 26, 63, 0.7);
    margin-bottom: 1.5rem;
  }

  .post-author {
    font-weight: 600;
    color: var(--brand-blue);
  }

  .separator {
    color: rgba(12, 26, 63, 0.4);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.75rem;
    background: rgba(221, 167, 68, 0.1);
    color: var(--brand-blue);
    border-radius: 20px;
    font-weight: 500;
  }

  /* Markdown Content Styles */
  .post-content {
    font-size: 1.125rem;
    line-height: 1.8;
    color: rgba(12, 26, 63, 0.85);
  }

  .post-content :global(h2) {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--brand-blue);
    margin: 3rem 0 1.5rem 0;
    line-height: 1.3;
  }

  .post-content :global(h3) {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--brand-blue);
    margin: 2.5rem 0 1rem 0;
    line-height: 1.3;
  }

  .post-content :global(p) {
    margin: 0 0 1.5rem 0;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 1.5rem 0;
    padding-left: 2rem;
  }

  .post-content :global(li) {
    margin: 0.5rem 0;
  }

  .post-content :global(strong) {
    font-weight: 700;
    color: var(--brand-blue);
  }

  .post-content :global(em) {
    font-style: italic;
  }

  .post-content :global(a) {
    color: var(--brand-gold);
    text-decoration: underline;
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .post-content :global(a:hover) {
    color: #c49038;
  }

  .post-content :global(code) {
    background: rgba(12, 26, 63, 0.05);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    font-size: 0.95em;
    color: var(--brand-blue);
  }

  .post-content :global(pre) {
    background: var(--brand-blue);
    color: white;
    padding: 1.5rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 2rem 0;
  }

  .post-content :global(pre code) {
    background: transparent;
    padding: 0;
    color: white;
  }

  .post-content :global(blockquote) {
    border-left: 4px solid var(--brand-gold);
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: rgba(12, 26, 63, 0.75);
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.95rem;
    overflow-x: auto;
    display: block;
  }

  .post-content :global(thead) {
    background: var(--brand-blue);
    color: white;
  }

  .post-content :global(th) {
    padding: 0.75rem 1rem;
    text-align: left;
    font-weight: 600;
    white-space: nowrap;
  }

  .post-content :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid rgba(12, 26, 63, 0.1);
    color: rgba(12, 26, 63, 0.85);
  }

  .post-content :global(tbody tr:hover) {
    background: rgba(221, 167, 68, 0.05);
  }

  .post-content :global(hr) {
    border: none;
    border-top: 2px solid rgba(12, 26, 63, 0.1);
    margin: 3rem 0;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 3rem;
    margin-top: 3rem;
    border-top: 2px solid rgba(12, 26, 63, 0.1);
  }

  .back-link,
  .contact-link {
    font-size: 1rem;
    font-weight: 600;
    color: var(--brand-blue);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .back-link:hover,
  .contact-link:hover {
    color: var(--brand-gold);
  }

  @media (max-width: 768px) {
    .post-title {
      font-size: 2rem;
    }

    .post-description {
      font-size: 1.125rem;
    }

    .post-content {
      font-size: 1rem;
    }

    .post-footer {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>
