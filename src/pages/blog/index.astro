---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

// Get all blog posts, filter out drafts, and sort by date
const allPosts = await getCollection("blog", ({ data }) => {
  return data.draft !== true;
});

const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const seoTitle = "Blog | 72° AI Labs";
const seoDescription = "Practical insights on AI implementation, real-world case studies, and operational intelligence for growing businesses.";
const ogImage = "/og-blog.jpg"; // Create this 1200x630 image for social sharing

// Format date helper
function formatDate(date: Date): string {
  return date.toLocaleDateString("en-IN", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<Layout title={seoTitle} description={seoDescription} ogImage={ogImage}>
  <Nav />
  <main class="blog-page">
    <div class="max-w-[1200px] mx-auto px-6 lg:px-8 py-8 lg:py-10">

      <!-- Page Header -->
      <header class="blog-header">
        <h1 class="page-title">Blog</h1>
        <p class="page-subtitle">
          Practical insights on AI implementation, real-world case studies, and operational intelligence.
        </p>
      </header>

      <!-- Blog Posts Grid -->
      <div class="posts-grid">
        {sortedPosts.map((post) => (
          <article class="post-card">
            <a href={`/blog/${post.slug}`} class="post-link">
              <div class="post-meta">
                <span class="post-category">{post.data.category}</span>
              </div>
              <h2 class="post-title">{post.data.title}</h2>
              <p class="post-description">{post.data.description}</p>
              <div class="post-footer">
                <span class="post-author">{post.data.author}</span>
                <span class="post-date">{formatDate(post.data.pubDate)}</span>
              </div>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="post-tags">
                  {post.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
            </a>
          </article>
        ))}
      </div>

      {sortedPosts.length === 0 && (
        <div class="no-posts">
          <p>No blog posts published yet. Check back soon!</p>
        </div>
      )}

    </div>
  </main>
  <Footer />
</Layout>

<style>
  .blog-page {
    background: var(--brand-cream);
    min-height: 100vh;
  }

  .blog-header {
    text-align: left;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 3px solid var(--brand-gold);
  }

  .page-title {
    font-size: var(--text-4xl);
    font-weight: 800;
    color: var(--brand-blue);
    margin: 0 0 1rem 0;
  }

  .page-subtitle {
    font-size: var(--text-lg);
    color: rgba(12, 26, 63, 0.7);
    max-width: 700px;
    margin: 0;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
  }

  .post-card {
    background: white;
    border-radius: 12px;
    border: 2px solid rgba(12, 26, 63, 0.1);
    transition: all 0.3s ease;
    overflow: hidden;
  }

  .post-card:hover {
    border-color: var(--brand-gold);
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(12, 26, 63, 0.12);
  }

  .post-link {
    display: block;
    padding: 2rem;
    text-decoration: none;
    color: inherit;
  }

  .post-meta {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 1rem;
  }

  .post-category {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--brand-gold);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .featured-badge {
    background: var(--brand-gold);
    color: white;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .post-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--brand-blue);
    margin: 0 0 1rem 0;
    line-height: 1.3;
  }

  .post-description {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(12, 26, 63, 0.75);
    margin: 0 0 1.5rem 0;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid rgba(12, 26, 63, 0.1);
    margin-bottom: 1rem;
  }

  .post-author {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--brand-blue);
  }

  .post-date {
    font-size: 0.875rem;
    color: rgba(12, 26, 63, 0.6);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.75rem;
    background: rgba(221, 167, 68, 0.1);
    color: var(--brand-blue);
    border-radius: 20px;
    font-weight: 500;
  }

  .no-posts {
    text-align: left;
    padding: 4rem 2rem;
    color: rgba(12, 26, 63, 0.6);
    font-size: var(--text-lg);
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 2rem;
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
