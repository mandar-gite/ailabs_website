# Google Analytics 4
# Get your tracking ID from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Microsoft Clarity (optional)
# Get your ID from: https://clarity.microsoft.com/
PUBLIC_CLARITY_ID=

# Apollo.io website visitor tracker
# Settings > Website visitors in Apollo shows the appId inside the script
PUBLIC_APOLLO_APP_ID=
